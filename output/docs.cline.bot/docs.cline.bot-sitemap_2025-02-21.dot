/* Generated Site Map */
digraph SiteMap {
    /* General Graph Attributes */
    graph [layout=neato, overlap=false, splines=true];
    node [shape=circle, fontname="Arial", fontsize=12, style=filled, fillcolor=lightgray];
    edge [fontname="Arial", fontsize=10, fillcolor=orange];

